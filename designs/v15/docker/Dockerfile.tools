# Python toolchain for the v15 generator, meshing and post-processing, plus the compiled lattice-Boltzmann screen.
# Optional: the same packages install natively into .venv-cad (see designs/v15/README.md, Reproduce). Not yet built or tested.
FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends g++ libgl1 libglu1-mesa libxrender1 libxcursor1 libxft2 libxinerama1 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY source/requirements.txt source/requirements-fea.txt source/requirements-solvers.txt /tmp/req/
RUN pip install --no-cache-dir -r /tmp/req/requirements-fea.txt -r /tmp/req/requirements-solvers.txt
COPY airflow/lbm.cpp /tmp/lbm.cpp
RUN g++ -O3 -std=c++17 /tmp/lbm.cpp -o /usr/local/bin/veil-lbm
ENV VEIL_LBM=/usr/local/bin/veil-lbm
WORKDIR /repo
